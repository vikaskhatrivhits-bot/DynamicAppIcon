<?xml version="1.0" encoding="utf-8"?>
<!--
  Generated by `npm run icons:generate` from app-icons/icons.json. Do not edit by hand.

  Drawable aliases of the launcher mipmaps so the JS icon picker can show
  previews via <Image source={{ uri: 'app_icon_preview_x' }} />. React Native
  only resolves bare-name image URIs against the "drawable" type, and this way
  the artwork exists once, in mipmap-*, for both the launcher and the app.
-->
<resources>
    <drawable name="app_icon_preview_default">@mipmap/ic_launcher_default</drawable>
    <drawable name="app_icon_preview_holi">@mipmap/ic_launcher_holi</drawable>
    <drawable name="app_icon_preview_utrayan">@mipmap/ic_launcher_utrayan</drawable>
    <drawable name="app_icon_preview_diwali">@mipmap/ic_launcher_diwali</drawable>
    <drawable name="app_icon_preview_navratri">@mipmap/ic_launcher_navratri</drawable>
</resources>
